{
  "name": "summit-breeze",
  "displayName": "Summit Breeze",
  "description": "SMT-LIB language support via LSP",
  "version": "0.1.0",
  "publisher": "summit-breeze",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FStarLang/summit-breeze"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:smtlib"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "smtlib",
        "extensions": [
          ".smt2",
          ".smt"
        ],
        "aliases": [
          "SMT-LIB",
          "smtlib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "smtlib",
        "scopeName": "source.smtlib",
        "path": "./syntaxes/smtlib.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Summit Breeze",
      "properties": {
        "summitBreeze.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the summit-breeze-lsp binary. Leave empty to use the bundled binary (or fall back to PATH for development)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  }
}
